{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bihar Cine Collective Research Database Schema",
  "type": "object",
  "required": [
    "id",
    "entity_type",
    "name",
    "status",
    "sources",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "entity_type": {
      "enum": [
        "film",
        "person",
        "place",
        "organization",
        "event",
        "timeline",
        "collection"
      ]
    },
    "name": {
      "type": "string"
    },
    "alternate_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "seed",
        "reviewed",
        "verified",
        "needs-review",
        "archived"
      ]
    },
    "summary": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "film_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bihar_connections": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "born-in-bihar",
          "based-in-bihar",
          "shot-in-bihar",
          "story-set-in-bihar",
          "language-culture",
          "bihar-production",
          "bihar-exhibition",
          "bihar-event",
          "bihar-institution",
          "subject-about-bihar",
          "documented-association"
        ]
      }
    },
    "district": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "person",
          "role"
        ],
        "properties": {
          "person": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "title",
          "source_type"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "enum": [
              "official",
              "database",
              "archive",
              "news",
              "community",
              "secondary"
            ]
          },
          "retrieved": {
            "type": [
              "string",
              "null"
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "production_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "$ref": "#/$defs/relationship"
    },
    "media_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "url",
        "title",
        "source_type"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "official",
            "database",
            "archive",
            "news",
            "community",
            "secondary"
          ]
        },
        "retrieved": {
          "type": [
            "string",
            "null"
          ]
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "url",
        "media_type"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "enum": [
            "poster",
            "still",
            "portrait",
            "location",
            "document",
            "video"
          ]
        },
        "rights_status": {
          "enum": [
            "unknown",
            "public-domain",
            "licensed",
            "fair-use-context",
            "permission-required"
          ]
        },
        "credit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identifier": {
      "type": "object",
      "required": [
        "namespace",
        "value"
      ],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "unverified",
            "partially-verified",
            "verified",
            "archival-verified"
          ]
        },
        "checked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}